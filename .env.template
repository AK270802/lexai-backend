# Database settings
POSTGRES_DB=lexai
POSTGRES_USER=lexai
POSTGRES_PASSWORD=lexai_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://lexai:lexai_db_password@localhost:5432/lexai

# Redis settings
REDIS_URL=redis://localhost:6379/0

# MinIO settings
MINIO_ROOT_USER=lexai
MINIO_ROOT_PASSWORD=lexai_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=lexai-documents

# Qdrant settings
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=
EMBED_DIMENSIONS=768

# Ollama settings
OLLAMA_HOST=http://localhost:11434

# OpenRouter settings
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Task Models
MODEL_RESEARCH=llama3
MODEL_EXTRACTION=llama3
MODEL_DRAFTING=llama3
MODEL_EMBEDDING=nvidia/llama-nemotron-embed-vl-1b-v2:free
DEFAULT_LLM_PROVIDER=ollama

# Playbooks
PLAYBOOK_SIMILARITY_THRESHOLD=0.85

# Django settings
DJANGO_SECRET_KEY=your_django_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DRF_USER_RATE=1000/day
DRF_AI_RATE=60/min

# JWT settings
JWT_ACCESS_TOKEN_LIFETIME=60 # minutes
JWT_REFRESH_TOKEN_LIFETIME=7 # days

# Frontend settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
